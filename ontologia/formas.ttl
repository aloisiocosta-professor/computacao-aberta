@prefix ca: <urn:computacao-aberta:ontologia:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ca:RecursoShape a sh:NodeShape ; sh:targetSubjectsOf ca:idLocal ;
 sh:property [ sh:path ca:idLocal ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
 sh:property [ sh:path <http://www.w3.org/2000/01/rdf-schema#label> ; sh:minCount 1 ] ;
 sh:property [ sh:path ca:arquivoOrigem ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
 sh:property [ sh:path ca:hashOrigem ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] .

ca:DisciplinaShape a sh:NodeShape ; sh:targetClass ca:Disciplina ;
 sh:property [ sh:path ca:pertenceEixo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ca:Eixo ] ;
 sh:property [ sh:path ca:contemUnidade ; sh:minCount 1 ; sh:class ca:UnidadeHabilidade ] ;
 sh:property [ sh:path ca:preRequisitoDisciplina ; sh:class ca:Disciplina ] .

ca:UnidadeShape a sh:NodeShape ; sh:targetClass ca:UnidadeHabilidade ;
 sh:property [ sh:path ca:daDisciplina ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ca:Disciplina ] ;
 sh:property [ sh:path ca:preRequisitoUnidade ; sh:class ca:UnidadeHabilidade ] ;
 sh:property [ sh:path ca:referenciaCandidata ; sh:class ca:Referencia ] ;
 sh:property [ sh:path ca:temCurso ; sh:class ca:Curso ] ;
 sh:property [ sh:path ca:estadoEditorial ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("ROTEIRO" "AULA_INICIAL" "REVISADA") ] ;
 sh:property [ sh:path ca:estadoEvidencia ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("CONFIRMADO" "PARCIAL" "NÃO VERIFICADO") ] .

ca:RelacaoShape a sh:NodeShape ; sh:targetClass ca:RelacaoFonte ;
 sh:property [ sh:path ca:disciplinaDaRelacao ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ca:Disciplina ] ;
 sh:property [ sh:path ca:fonteDaRelacao ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ca:Referencia ] ;
 sh:property [ sh:path ca:funcaoProposta ; sh:minCount 1 ; sh:class ca:FuncaoAcademica ] ;
 sh:property [ sh:path ca:estadoDecisao ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("PROPOSTO" "DECIDIDO" "SUPERADO") ] ;
 sh:property [ sh:path ca:estadoEvidencia ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("CONFIRMADO" "PARCIAL" "NÃO VERIFICADO") ] .

ca:MissaoShape a sh:NodeShape ; sh:targetClass ca:Missao ;
 sh:property [ sh:path ca:integraDisciplina ; sh:minCount 2 ; sh:class ca:Disciplina ] ;
 sh:property [ sh:path ca:requerHabilidade ; sh:minCount 1 ; sh:class ca:UnidadeHabilidade ] ;
 sh:property [ sh:path ca:introduzHabilidade ; sh:class ca:UnidadeHabilidade ] .

ca:SemCicloShape a sh:NodeShape ; sh:targetClass ca:UnidadeHabilidade ;
 sh:sparql [ sh:message "Ciclo nos pré-requisitos editoriais."@pt ;
 sh:select """PREFIX ca: <urn:computacao-aberta:ontologia:>
 SELECT $this WHERE { $this ca:preRequisitoUnidade+ $this . }""" ] .
